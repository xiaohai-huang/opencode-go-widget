#!/bin/sh
# Launcher for the OpenCode Go Widget.
# Wayland blocks programmatic window placement, so prefer Xwayland.
# Resolve symlinks so /usr/bin/opencode-go-widget can point at the real script.
SELF=$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")
APP_DIR="$(cd "$(dirname "$SELF")/.." && pwd)"
if [ -z "$GDK_BACKEND" ] && [ -n "$DISPLAY" ] && [ -S /tmp/.X11-unix/X0 ]; then
    export GDK_BACKEND=x11
fi
exec /usr/bin/python3 "$APP_DIR/main.py" "$@"
